# Francisco Santelices Ariztía - Minimal Configuration
# www.franciscosantelices.cl

# Force HTTPS and redirect www to non-www
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.franciscosantelices\.cl$ [NC]
    RewriteRule ^(.*)$ https://franciscosantelices.cl/$1 [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Custom error pages
ErrorDocument 404 /index.html

# MIME types
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
